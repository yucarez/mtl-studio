# =====================================================================
#  MTL Studio configuration. Copy to `.env` and fill in what you use.
#  You need at least ONE translator key (or an OpenAI-compatible local
#  server). Without any, only the "No translation (layout test)" mode runs.
# =====================================================================

# --- Anthropic Claude (recommended: sees the page, fixes OCR, keeps context)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- OpenAI, or ANY OpenAI-compatible server (Ollama, vLLM, LM Studio, OpenRouter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=https://api.openai.com/v1
# Set false if your model cannot read images (text-only context is used then)
OPENAI_SUPPORTS_VISION=true
# Local example (no key needed):
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_MODEL=qwen2.5vl:32b

# --- DeepL / Google (plain text translation, no page context)
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Runtime
DEVICE=auto              # auto | cpu | cuda
ENABLE_LAMA=true
MAX_UPLOAD_MB=60
LLM_TIMEOUT_S=180
# DATA_DIR=./data
# FONT_DIR=./fonts

# --- PaddleOCR model names (defaults are the accurate "server" models)
# PADDLE_DET_MODEL=PP-OCRv5_server_det
# PADDLE_REC_MODEL=PP-OCRv5_server_rec
# PADDLE_REC_MODEL_KO=korean_PP-OCRv5_mobile_rec
# PADDLE_REC_MODEL_LATIN=latin_PP-OCRv5_mobile_rec
# PADDLE_REC_MODEL_CYRILLIC=eslav_PP-OCRv5_mobile_rec
# PADDLE_REC_MODEL_TH=th_PP-OCRv5_mobile_rec
